GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=models/gemini-flash-latest

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
AI_AUDIO_MAX_BYTES=15728640
AI_AUDIO_MAX_DURATION_SECONDS=120

OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_CIRCUIT_FAILURE_THRESHOLD=3
LOG_LEVEL=INFO
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-configured-in-backend
AI_CONTEXT_SIGNING_KEY=replace-with-a-different-random-secret-shared-with-backend

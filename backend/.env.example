# Keep this value identical to ia_service/.env and keep the real secret out of Git.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
DB_NAME=barakagive
DB_USER=barakagive
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=db
DB_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
IA_SERVICE_URL=http://ia_service:8001
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Keep this value identical to ia_service/.env; do not expose it to Vue.
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-configured-in-ia-service
AI_CONTEXT_SIGNING_KEY=replace-with-a-different-random-secret-shared-with-ia_service
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@example.test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_SUCCESS_URL=http://localhost:5173/payment/success
PAYTECH_CANCEL_URL=http://localhost:5173/payment/cancel
PAYTECH_IPN_URL=http://localhost:8000/api/payment/webhook/
